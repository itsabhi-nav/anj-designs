# ─────────────────────────────────────────────────────────────────────────────
# ANJ Designs — environment configuration
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Contact form delivery ────────────────────────────────────────────────────
# The contact form is only reported as "delivered" once the server confirms a
# successful hand-off to the provider. With no provider configured the API
# returns 503 and the UI offers a pre-filled mailto fallback instead of
# pretending the message was sent.
#
# Provider: Resend (https://resend.com) — `RESEND_API_KEY` + `CONTACT_TO_EMAIL`
RESEND_API_KEY=
CONTACT_FROM_EMAIL=website@anjdesigns.in
CONTACT_TO_EMAIL=decorinndesigns@gmail.com

# ── Image delivery (optional) ────────────────────────────────────────────────
# Leave CLOUDINARY_CLOUD_NAME empty to use the default Next.js image optimiser
# (recommended for a self-hosted/Vercel deployment). Set it to deliver every
# image through the Cloudinary CDN instead — the two paths are mutually
# exclusive, images are never transformed twice.
#
# When enabled, assets must be uploaded to Cloudinary using the folder
# structure: anjdesigns/<publicId>  (see docs/MEDIA-PIPELINE.md)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_DELIVERY_TYPE=auto
CLOUDINARY_QUALITY=auto

# ── Site ─────────────────────────────────────────────────────────────────────
# The canonical origin. It is used for the sitemap, robots.txt and — crucially
# for social platforms — the absolute Open Graph image URL. If this does not
# match the domain the site is served from, link previews on Instagram,
# WhatsApp and LinkedIn will show no image.
NEXT_PUBLIC_SITE_URL=https://www.anjdesigns.codewizard.online
